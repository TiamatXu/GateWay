  "query": "UPDATE async_task\n                SET state = $2,\n                    phase = $3,\n                    polled_at = now(),\n                    settled_at = CASE WHEN $3::SMALLINT <> 0 THEN now() ELSE settled_at END\n              WHERE handle_id = $1 AND phase = 0\n              RETURNING handle_id, submit_endpoint, inbound, model, request_id, phase, state, created_at",
